PROJECT_NAME="Upteky AI"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT (Must be set to a secure, random >=32 char string in production)
JWT_SECRET="your-super-secret-production-key-min-32-chars-generate-with-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL default, falls back gracefully to SQLite if unavailable in local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/upteky_db"
# To force sqlite for quick local testing without PostgreSQL running:
# DATABASE_URL="sqlite:///./upteky_local.db"

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# AI / LLM Configuration
LLM_PROVIDER="mock"  # options: mock, openai, gemini
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
